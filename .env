# Generate a fresh token with @BotFather. Never commit the real .env file.
BOT_TOKEN=PASTE_YOUR_NEW_TELEGRAM_BOT_TOKEN_HERE

# Local Windows path. Render overrides this with /var/data/bd_otp_pro.sqlite3.
DATABASE_PATH=./data/bd_otp_pro.sqlite3

# Comma-separated numeric Telegram user IDs. Leave empty until configured.
ADMIN_IDS=

# Optional Telegram support username, without @.
SUPPORT_USERNAME=

# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO
